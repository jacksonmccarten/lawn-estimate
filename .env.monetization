# AWS Monetization: the app that sells companies their plan (services/lambdas/src/billing.ts).
# No secret here. Read by the local API (npm run dev:api) with your own AWS credentials;
# the deployed Lambdas get the same values from infra/cdk.json.
#
# Sandbox: test cards, no real charges. Live: real customers, real charges.
# To switch, swap which line is commented (and monetizationAppId in infra/cdk.json), then redeploy.
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:872515276223:apps/01a12cae79d47e3fb145ef443c8c38e8/sandbox
MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:872515276223:apps/01a12cae79d47e3fb145ef443c8c38e8
MONETIZATION_ENDPOINT=https://us-west-2.alpha.monetization.aws.dev
MONETIZATION_REGION=us-west-2
