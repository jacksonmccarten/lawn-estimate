# Local loop: the widget against the local API (npm run dev:api) instead of fixtures.
# Copy to .env.local. None of this is secret; the Turnstile key is Cloudflare's
# published test key, which always passes.
LQ_FIXTURES=0
LQ_API_BASE=http://localhost:8787
LQ_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The aerial photo. A Mapbox PUBLIC token (pk.), restricted to your origins in
# the Mapbox account. Put the real one in .env.local only, never in this file.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.
