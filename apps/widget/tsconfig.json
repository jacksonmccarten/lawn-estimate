{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "incremental": false
  },
  "include": ["src", "test", "e2e", "*.ts"],
  "exclude": ["node_modules", ".next"]
}
