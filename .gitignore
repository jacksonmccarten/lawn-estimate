# Environment variables — never commit credentials
.env
.env.*
!.env.example

# Secret material
*.pem
*.key

# Claude Code — personal overrides stay local; settings.json is shared
.claude/settings.local.json
# Claude Code worktrees are local checkouts, never committed
.claude/worktrees/

# Obsidian — per-machine UI state (vault config itself is committed)
**/.obsidian/workspace*.json
**/.obsidian/cache
.trash/

# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules/

# OS / editor
Thumbs.db
.DS_Store
